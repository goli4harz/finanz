    {
      "parameters": {
        "jsCode": "// NUR ALTE NEWS LÖSCHEN (älter als 3 Tage)\n// Modus: runOnceForAllItems\n// Gibt nur alte Items mit gültiger id weiter.\n\nconst heute = new Date();\nconst grenzeDatum = new Date(heute);\ngrenzeDatum.setDate(grenzeDatum.getDate() - 3);\nconst grenzeISO = grenzeDatum.toISOString().substring(0, 10);\n\nconst alleZeilen = $input.all().map(i => i.json);\n\nconst alteZeilen = alleZeilen.filter(z => {\n  if (!z.id && z.id !== 0) return false;\n  const d = String(z.datum_iso || z.datum || '');\n  if (!d) return true;\n  return d.substring(0, 10) < grenzeISO;\n});\n\nif (alteZeilen.length === 0) return [];\n\nreturn alteZeilen.map(z => ({\n  json: { ...z, _delete_reason: 'older_than_3_days' }\n}));"
      },
