      "id": "c8f8ac29-2d17-4cd9-a12f-a8f7915b5471",
      "name": "Markt-Kursdaten abrufen (lokaler FastAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -1120,
