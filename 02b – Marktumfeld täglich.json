    {
      "parameters": {
        "jsCode": "// MARKT: ROUTING – Run Once for All Items\n// Input: DB-Zeilen aus \"DB: Marktumfeld suchen\" (nach symbol gefiltert)\n// Quelle: frische Marktdaten aus \"Marktanalyse berechnen\"\n//\n// Für jeden Markt-Input: prüfen ob DB-Eintrag vorhanden (anhand id)\n// DB: Marktumfeld suchen läuft per Item (filter: symbol = $json.symbol)\n// → für jeden Markt genau 1 DB-Ergebnis (oder leer)\n\nconst suchItems  = $input.all();\nconst marktItems = $('Marktanalyse berechnen').all();\n\nreturn suchItems.map((item, index) => {\n  const suchItem  = item.json || {};\n  const marktItem = (marktItems[index] || { json: {} }).json;\n\n  const rowExists =\n    suchItem.id !== undefined &&\n    suchItem.id !== null &&\n    String(suchItem.id).trim() !== '';\n\n  return {\n    json: {\n      ...marktItem,\n      _existing_id: rowExists ? String(suchItem.id) : '',\n      _rowExists:   rowExists\n    }\n  };\n});\n"
      },
