      "parameters": {
        "jsCode": "const dbRows = $input.all().map(i => i.json || {});\nconst marktItems = $('Marktanalyse berechnen').all().map(i => i.json || {});\n\nconst foundBySymbol = {};\nfor (const row of dbRows) {\n  const symbol = String(row.symbol || '').trim();\n  const hasId = row.id !== undefined && row.id !== null && String(row.id).trim() !== '';\n  if (symbol && hasId) foundBySymbol[symbol] = row;\n}\n\nreturn marktItems.map(markt => {\n  const symbol = String(markt.symbol || '').trim();\n  const found = foundBySymbol[symbol];\n  const rowExists = found !== undefined && found.id !== undefined && found.id !== null && String(found.id).trim() !== '';\n  return {\n    json: {\n      ...markt,\n      _existing_id: rowExists ? String(found.id) : '',\n      _rowExists: Boolean(rowExists)\n    }\n  };\n});"
      },
