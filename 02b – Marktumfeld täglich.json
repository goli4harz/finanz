    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// MARKTANALYSE BERECHNEN\n// Modus: runOnceForEachItem\n// Gleiche Logik wie Technische Analyse, aber ohne Handelsbewertung.\n// Ziel: Markt­status (risk_on / risk_off / neutral) für Kontextualisierung.\n\nconst input  = $input.item.json;\nconst meta_w = $('Markt-Watchlist laden').item.json;\n\nconst symbol       = meta_w.symbol       || input.symbol       || '';\nconst name         = meta_w.name         || '';\nconst markt_typ    = meta_w.markt_typ    || '';\nconst region       = meta_w.region       || '';\nconst waehrung     = meta_w.waehrung     || '';\nconst referenz_fuer = meta_w.referenz_fuer || '';\n\nconst heute      = new Date().toISOString().substring(0, 10);\nconst zeitstempel = new Date().toISOString();\n\nconst fehlObj = (msg) => ({ json: {\n  symbol, name, markt_typ, region, waehrung, referenz_fuer,\n  datum: heute, zeitstempel, type: 'market_context',\n  aktueller_kurs: null, veraenderung_abs: null, veraenderung_pct: null,\n  rsi: null, rsi_signal: '', macd: null, macd_signal_linie: null,\n  macd_histogramm: null, macd_signal: '', trend: '', ema20: null,\n  bb_oben: null, bb_mitte: null, bb_unten: null, kurs_bei_bollinger: '',\n  signal_punkte: 0, signal_gruende: '', signal_staerke: '',\n  markt_status: 'unbekannt', risk_level: 'unbekannt', markt_hinweis: msg,\n  quelle: 'Yahoo Finance', status: 'fehler', fehler: msg\n}});\n\ntry {\n  if (!input.chart?.result?.[0]) return fehlObj('Keine Chartdaten');\n  const chart = input.chart.result[0];\n  const meta  = chart.meta || {};\n  const quote = chart.indicators?.quote?.[0];\n  if (!quote) return fehlObj('Keine Quote-Daten');\n\n  const closes = (quote.close  || []).filter(v => v != null && !isNaN(v));\n  if (closes.length < 26) return fehlObj(`Zu wenige Datenpunkte (${closes.length})`);\n\n  const aktKurs  = closes[closes.length - 1];\n  const vorKurs  = closes[closes.length - 2];\n  const veraAbs  = parseFloat((aktKurs - vorKurs).toFixed(4));\n  const veraPct  = parseFloat(((aktKurs - vorKurs) / vorKurs * 100).toFixed(2));\n\n  // EMA-Hilfsfunktionen\n  function ema(arr, p) {\n    if (arr.length < p) return null;\n    const k = 2 / (p + 1);\n    let e = arr.slice(0, p).reduce((a, b) => a + b, 0) / p;\n    for (let i = p; i < arr.length; i++) e = arr[i] * k + e * (1 - k);\n    return e;\n  }\n  function emaSeries(arr, p) {\n    if (arr.length < p) return [];\n    const k = 2 / (p + 1);\n    const res = [];\n    let e = arr.slice(0, p).reduce((a, b) => a + b, 0) / p;\n    for (let i = 0; i < arr.length; i++) {\n      if (i < p - 1) res.push(null);\n      else if (i === p - 1) res.push(e);\n      else { e = arr[i] * k + e * (1 - k); res.push(e); }\n    }\n    return res;\n  }\n  function rsi14(arr) {\n    if (arr.length <= 14) return null;\n    let g = 0, l = 0;\n    for (let i = arr.length - 14; i < arr.length; i++) {\n      const d = arr[i] - arr[i - 1];\n      if (d > 0) g += d; else l += Math.abs(d);\n    }\n    const ag = g / 14, al = l / 14;\n    return al === 0 ? 100 : 100 - (100 / (1 + ag / al));\n  }\n  const r = (v, d = 2) => v == null || isNaN(v) ? null : parseFloat(v.toFixed(d));\n\n  // RSI\n  const rsiVal    = r(rsi14(closes), 1);\n  const rsiSignal = rsiVal == null ? '' :\n    rsiVal < 25 ? 'STARK ÜBERVERKAUFT' : rsiVal < 35 ? 'Überverkauft' :\n    rsiVal > 75 ? 'STARK ÜBERKAUFT'    : rsiVal > 65 ? 'Überkauft' : 'Neutral';\n\n  // MACD\n  const ema12S = emaSeries(closes, 12);\n  const ema26S = emaSeries(closes, 26);\n  const macdFull = closes.map((_, i) =>\n    ema12S[i] != null && ema26S[i] != null ? ema12S[i] - ema26S[i] : null\n  ).filter(v => v != null);\n\n  if (macdFull.length < 9) return fehlObj('MACD-Datenbasis zu gering');\n\n  const sigS    = emaSeries(macdFull, 9).filter(v => v != null);\n  const macdV   = macdFull[macdFull.length - 1];\n  const macdSig = sigS[sigS.length - 1];\n  const macdHist = r(macdV - macdSig);\n\n  let macdSignal = 'Neutral';\n  const macdPrev = macdFull[macdFull.length - 2];\n  const sigPrev  = sigS[sigS.length - 2];\n  if (macdPrev <= sigPrev && macdV > macdSig) macdSignal = 'Bullische Kreuzung';\n  else if (macdPrev >= sigPrev && macdV < macdSig) macdSignal = 'Bärische Kreuzung';\n  else if (macdV > macdSig) macdSignal = 'Bullisch';\n  else if (macdV < macdSig) macdSignal = 'Bärisch';\n\n  // EMA20 / Trend\n  const ema20V  = r(ema(closes, 20));\n  const aufwaerts = aktKurs > ema20V;\n\n  // Bollinger\n  const bb20  = closes.slice(-20);\n  const bbAvg = bb20.reduce((a, b) => a + b, 0) / 20;\n  const bbStd = Math.sqrt(bb20.map(p => (p - bbAvg) ** 2).reduce((a, b) => a + b, 0) / 20);\n  const bbO   = r(bbAvg + 2 * bbStd);\n  const bbU   = r(bbAvg - 2 * bbStd);\n  const bbPos = aktKurs >= bbO * 0.995 ? 'oben' : aktKurs <= bbU * 1.005 ? 'unten' : 'mitte';\n\n  // Signal-Punkte (vereinfacht)\n  let punkte = 0;\n  const gruende = [];\n  if (rsiVal != null) {\n    if (rsiVal < 25 || rsiVal > 75) { punkte += 3; gruende.push('RSI extrem'); }\n    else if (rsiVal < 35 || rsiVal > 65) { punkte += 2; gruende.push('RSI stark'); }\n  }\n  if (macdSignal.includes('Kreuzung')) { punkte += 3; gruende.push(`MACD ${macdSignal}`); }\n  else if (macdSignal !== 'Neutral') { punkte += 1; gruende.push(`MACD ${macdSignal}`); }\n  if (bbPos !== 'mitte') { punkte += 2; gruende.push(`Bollinger ${bbPos}`); }\n\n  const signalStaerke = punkte >= 6 ? 'hoch' : punkte >= 3 ? 'mittel' : 'niedrig';\n\n  // markt_status\n  const macdBullisch = macdSignal === 'Bullisch' || macdSignal === 'Bullische Kreuzung';\n  const macdBaerisch = macdSignal === 'Bärisch'  || macdSignal === 'Bärische Kreuzung';\n\n  let markt_status, risk_level, markt_hinweis;\n\n  if (aufwaerts && macdBullisch && veraPct >= -0.5) {\n    markt_status = 'risk_on';\n    risk_level   = veraPct >= 0.5 ? 'niedrig' : 'mittel';\n    markt_hinweis = `${name} über EMA20, MACD bullisch. Tagesveränderung ${veraPct}%.`;\n  } else if (!aufwaerts && macdBaerisch && veraPct <= -1.0) {\n    markt_status = 'risk_off';\n    risk_level   = veraPct <= -2.0 ? 'hoch' : 'mittel';\n    markt_hinweis = `${name} unter EMA20, MACD bärisch. Tagesveränderung ${veraPct}%.`;\n  } else if (!aufwaerts && veraPct <= -1.0) {\n    markt_status = 'risk_off';\n    risk_level   = 'mittel';\n    markt_hinweis = `${name} unter EMA20 mit negativer Tagesperformance (${veraPct}%).`;\n  } else if (aufwaerts && veraPct >= 0.5) {\n    markt_status = 'risk_on';\n    risk_level   = 'niedrig';\n    markt_hinweis = `${name} über EMA20, positive Performance (${veraPct}%).`;\n  } else {\n    markt_status = 'neutral';\n    risk_level   = 'niedrig';\n    markt_hinweis = `${name} zeigt keine klare Richtung. Tagesveränderung ${veraPct}%.`;\n  }\n\n  return { json: {\n    symbol, name, markt_typ, region, waehrung, referenz_fuer,\n    datum: heute, zeitstempel, type: 'market_context',\n    aktueller_kurs:    r(aktKurs, 4),\n    veraenderung_abs:  veraAbs,\n    veraenderung_pct:  veraPct,\n    rsi:               rsiVal,\n    rsi_signal:        rsiSignal,\n    macd:              r(macdV),\n    macd_signal_linie: r(macdSig),\n    macd_histogramm:   macdHist,\n    macd_signal:       macdSignal,\n    trend:             aufwaerts ? 'Aufwärts' : 'Abwärts',\n    ema20:             ema20V,\n    bb_oben:           bbO,\n    bb_mitte:          r(bbAvg),\n    bb_unten:          bbU,\n    kurs_bei_bollinger: bbPos,\n    signal_punkte:     punkte,\n    signal_gruende:    gruende.join(', '),\n    signal_staerke:    signalStaerke,\n    markt_status,\n    risk_level,\n    markt_hinweis,\n    quelle: 'Yahoo Finance',\n    status: 'ok',\n    fehler: ''\n  }};\n} catch(e) {\n  return fehlObj(e.message);\n}\n"
      },
