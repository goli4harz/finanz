    {
      "parameters": {
        "jsCode": "function pgStr(v) { return v === null || v === undefined || v === '' ? 'NULL' : `'` + String(v).replace(/'/g, `''`) + `'`; }\nfunction pgNum(v) { return v === null || v === undefined || v === '' || isNaN(Number(v)) ? 'NULL' : Number(v); }\n\nconst j = $json;\nconst sql = `INSERT INTO trading.stock_price_history\n  (symbol, trading_date, close, currency, source)\n  VALUES (${pgStr(j.symbol)}, ${pgStr(j.datum)}, ${pgNum(j.aktueller_kurs)}, ${pgStr(j.waehrung)}, 'marktumfeld-02b')\n  ON CONFLICT (symbol, trading_date) DO UPDATE SET\n    close = EXCLUDED.close, currency = EXCLUDED.currency, source = EXCLUDED.source, fetched_at = now();`;\nreturn { json: { ...j, sql } };"
