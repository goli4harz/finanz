      "parameters": {
        "jsCode": "// MARKT-WATCHLIST LADEN\n// Gibt Marktindizes, Währungen und Rohstoffe als Items aus.\nconst watchlist = [\n  { symbol: '^GDAXI',   name: 'DAX',             markt_typ: 'index',    region: 'Deutschland', waehrung: 'EUR',     referenz_fuer: 'SAP.DE,SIE.DE,BASF.DE,ALV.DE,MBG.DE,BMW.DE,VOW3.DE,DBK.DE,DTE.DE,RWE.DE,BAYN.DE,EOAN.DE,ADS.DE,HEN3.DE,FRE.DE' },\n  { symbol: '^MDAXI',   name: 'MDAX',            markt_typ: 'index',    region: 'Deutschland', waehrung: 'EUR',     referenz_fuer: 'deutsche_nebenwerte' },\n  { symbol: '^STOXX50E',name: 'Euro Stoxx 50',   markt_typ: 'index',    region: 'Europa',      waehrung: 'EUR',     referenz_fuer: 'europa' },\n  { symbol: '^IXIC',    name: 'Nasdaq Composite',markt_typ: 'index',    region: 'USA',         waehrung: 'USD',     referenz_fuer: 'technologie' },\n  { symbol: '^GSPC',    name: 'S&P 500',         markt_typ: 'index',    region: 'USA',         waehrung: 'USD',     referenz_fuer: 'global' },\n  { symbol: 'EURUSD=X', name: 'EUR/USD',         markt_typ: 'waehrung', region: 'FX',          waehrung: 'EUR/USD', referenz_fuer: 'export_import' },\n  { symbol: 'CL=F',     name: 'WTI Öl',          markt_typ: 'rohstoff', region: 'global',      waehrung: 'USD',     referenz_fuer: 'energie_inflation' },\n  { symbol: 'GC=F',     name: 'Gold',            markt_typ: 'rohstoff', region: 'global',      waehrung: 'USD',     referenz_fuer: 'risk_off' }\n];\nreturn watchlist.map(s => ({ json: s }));\n"
      },
