    {
      "parameters": {
        "jsCode": "// FUNDAMENTALDATEN ROUTING – Run Once for All Items\n// Input: vorhandene DB-Zeilen aus \"DB: Fundamental suchen\"\n// Quelle: frische Fundamentaldaten aus \"Fundamentaldaten aufbereiten & speichern\"\n\nconst dbRowsRaw = $input.all()\n  .map(item => item.json || {})\n  .filter(row => row.ticker);\n\nconst dbByTicker = {};\n\nfor (const row of dbRowsRaw) {\n  const ticker = String(row.ticker || '').trim();\n  if (!ticker) continue;\n\n  // Falls derselbe Ticker mehrfach vorhanden ist, nimm bevorzugt den mit ID.\n  if (!dbByTicker[ticker] || row.id) {\n    dbByTicker[ticker] = row;\n  }\n}\n\nconst sourceItems = $('Fundamentaldaten aufbereiten & speichern').all();\n\nreturn sourceItems.map(item => {\n  const source = item.json || {};\n  const ticker = String(source.ticker || '').trim();\n  const existing = dbByTicker[ticker];\n\n  const rowExists =\n    existing &&\n    existing.id !== undefined &&\n    existing.id !== null &&\n    String(existing.id).trim() !== '';\n\n  return {\n    json: {\n      ...source,\n      _existing_id: rowExists ? String(existing.id) : '',\n      _rowExists: Boolean(rowExists)\n    }\n  };\n});"
      },
