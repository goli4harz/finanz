    {
      "parameters": {
        "jsCode": "function pgStr(v) { return v === null || v === undefined || v === '' ? 'NULL' : `'` + String(v).replace(/'/g, `''`) + `'`; }\nfunction pgNum(v) { return (v === null || v === undefined || v === '' || isNaN(Number(v))) ? 'NULL' : Number(v); }\n\n// FIX 2026-07-31 Teil 2 (Phase 5 Schritt 1, live als Bug gefunden: alle *_numeric-Felder\n// bekamen denselben Wert - offenbar wegen desselben Vorgangs-uebergreifenden Item-Mixings,\n// das $('...').item.json quer durch dieses Repo an mehreren Stellen zeigt): $json ist der\n// Rueckgabewert von \"DB: Fundamental aktualisieren\"/\"neu anlegen\" (Data-Table-Node), die\n// gibt nur ihre EIGENEN Spalten zurueck - die neuen *_numeric/currency-Felder existieren in\n// der n8n Data Table nicht und gehen verloren. .item (singular) loeste hier nicht zuverlaessig\n// das richtige Item auf. Robuster Ersatz: .all() + explizites Matching auf ticker (das Feld\n// ueberlebt den Data-Table-Roundtrip zuverlaessig, siehe kgv/marktkapitalisierung oben).\nfunction numericSourceFor(ticker) {\n  try {\n    const all = $('Fundamentaldaten aufbereiten & speichern').all();\n    const match = all.find(i => i.json && i.json.ticker === ticker);\n    return match ? match.json : {};\n  } catch (e) { return {}; }\n}\nconst numericSource = numericSourceFor($json.ticker);\nconst j = { ...$json, ...Object.fromEntries(Object.entries(numericSource).filter(([k]) => k === 'waehrung' || k.endsWith('_numeric'))) };\nconst sql = `INSERT INTO trading.fundamentals_history\n  (ticker, snapshot_date, name, kgv, \"kgvForward\", kbv, \"dividendeRendite\", \"dividendeJe\", \"exDividendeDatum\", \"dividendenDatum\", \"naechsterBericht\", beta, marktkapitalisierung, verschuldungsgrad, eigenkapitalrendite, gewinnmarge, kursziel, empfehlung, zeitstempel, quelle, status, fehler, letzter_fehler_zeitpunkt, currency, kgv_numeric, kgv_forward_numeric, kbv_numeric, dividende_rendite_numeric, dividende_je_numeric, beta_numeric, marktkapitalisierung_numeric, verschuldungsgrad_numeric, eigenkapitalrendite_numeric, gewinnmarge_numeric, kursziel_numeric, regular_market_price_numeric)\n  VALUES (${pgStr(j.ticker)}, ${pgStr(j.datum)}, ${pgStr(j.name)}, ${pgStr(j.kgv)}, ${pgStr(j.kgvForward)}, ${pgStr(j.kbv)}, ${pgStr(j.dividendeRendite)}, ${pgStr(j.dividendeJe)}, ${pgStr(j.exDividendeDatum)}, ${pgStr(j.dividendenDatum)}, ${pgStr(j.naechsterBericht)}, ${pgStr(j.beta)}, ${pgStr(j.marktkapitalisierung)}, ${pgStr(j.verschuldungsgrad)}, ${pgStr(j.eigenkapitalrendite)}, ${pgStr(j.gewinnmarge)}, ${pgStr(j.kursziel)}, ${pgStr(j.empfehlung)}, ${pgStr(j.zeitstempel)}, ${pgStr(j.quelle)}, ${pgStr(j.status)}, ${pgStr(j.fehler)}, ${pgStr(j.letzter_fehler_zeitpunkt)}, ${pgStr(j.waehrung)}, ${pgNum(j.kgv_numeric)}, ${pgNum(j.kgv_forward_numeric)}, ${pgNum(j.kbv_numeric)}, ${pgNum(j.dividende_rendite_numeric)}, ${pgNum(j.dividende_je_numeric)}, ${pgNum(j.beta_numeric)}, ${pgNum(j.marktkapitalisierung_numeric)}, ${pgNum(j.verschuldungsgrad_numeric)}, ${pgNum(j.eigenkapitalrendite_numeric)}, ${pgNum(j.gewinnmarge_numeric)}, ${pgNum(j.kursziel_numeric)}, ${pgNum(j.regular_market_price_numeric)})\n  ON CONFLICT (ticker, snapshot_date) DO UPDATE SET\n    name = EXCLUDED.name,\n    kgv = EXCLUDED.kgv,\n    \"kgvForward\" = EXCLUDED.\"kgvForward\",\n    kbv = EXCLUDED.kbv,\n    \"dividendeRendite\" = EXCLUDED.\"dividendeRendite\",\n    \"dividendeJe\" = EXCLUDED.\"dividendeJe\",\n    \"exDividendeDatum\" = EXCLUDED.\"exDividendeDatum\",\n    \"dividendenDatum\" = EXCLUDED.\"dividendenDatum\",\n    \"naechsterBericht\" = EXCLUDED.\"naechsterBericht\",\n    beta = EXCLUDED.beta,\n    marktkapitalisierung = EXCLUDED.marktkapitalisierung,\n    verschuldungsgrad = EXCLUDED.verschuldungsgrad,\n    eigenkapitalrendite = EXCLUDED.eigenkapitalrendite,\n    gewinnmarge = EXCLUDED.gewinnmarge,\n    kursziel = EXCLUDED.kursziel,\n    empfehlung = EXCLUDED.empfehlung,\n    zeitstempel = EXCLUDED.zeitstempel,\n    quelle = EXCLUDED.quelle,\n    status = EXCLUDED.status,\n    fehler = EXCLUDED.fehler,\n    letzter_fehler_zeitpunkt = EXCLUDED.letzter_fehler_zeitpunkt,\n    currency = EXCLUDED.currency,\n    kgv_numeric = EXCLUDED.kgv_numeric,\n    kgv_forward_numeric = EXCLUDED.kgv_forward_numeric,\n    kbv_numeric = EXCLUDED.kbv_numeric,\n    dividende_rendite_numeric = EXCLUDED.dividende_rendite_numeric,\n    dividende_je_numeric = EXCLUDED.dividende_je_numeric,\n    beta_numeric = EXCLUDED.beta_numeric,\n    marktkapitalisierung_numeric = EXCLUDED.marktkapitalisierung_numeric,\n    verschuldungsgrad_numeric = EXCLUDED.verschuldungsgrad_numeric,\n    eigenkapitalrendite_numeric = EXCLUDED.eigenkapitalrendite_numeric,\n    gewinnmarge_numeric = EXCLUDED.gewinnmarge_numeric,\n    kursziel_numeric = EXCLUDED.kursziel_numeric,\n    regular_market_price_numeric = EXCLUDED.regular_market_price_numeric,\n    fetched_at = now();`;\n\nreturn { json: { ...j, sql } };\n",
        "mode": "runOnceForEachItem"
      },
