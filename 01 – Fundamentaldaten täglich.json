      "id": "ba1aed7f-fed3-4d47-b03b-8620ea10e30b",
      "name": "Fundamentaldaten abrufen (lokaler FastAPI)",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// FUNDAMENTALDATEN AUFBEREITEN & SPEICHERN v3 – FastAPI Flat-JSON\n// Modus: runOnceForAllItems\n// Unterstützt drei Eingabeformate:\n//   1. item.json.ticker vorhanden → direktes Flat-JSON\n//   2. item.json.body ist Objekt  → Flat-JSON unter body\n//   3. item.json.body ist String  → JSON.parse(body)\n\nconst items = $input.all();\nconst ergebnisse = [];\nconst heute       = new Date().toISOString().substring(0, 10);\nconst zeitstempel = new Date().toISOString();\n\nconst sd = $getWorkflowStaticData('global');\nif (!sd.fundamentaldaten) sd.fundamentaldaten = {};\n\nfunction fmt(v, digits) {\n  const n = Number(v);\n  if (v == null || v === '' || isNaN(n)) return 'k.A.';\n  return n.toFixed(digits);\n}\nfunction fmtMrd(v) {\n  const n = Number(v);\n  if (v == null || v === '' || isNaN(n)) return 'k.A.';\n  return (n / 1e9).toFixed(1) + ' Mrd.';\n}\nfunction num(v) { const n = Number(v); return (v == null || v === '' || isNaN(n)) ? null : n; }\nfunction fmtStr(v) {\n  if (v == null || v === '') return 'k.A.';\n  return String(v);\n}\n\nfunction parseRaw(item) {\n  const j = item.json;\n  // Fall 1: direktes Flat-JSON\n  if (j && j.ticker) return j;\n  // Fall 2 + 3: body\n  if (j && j.body != null) {\n    if (typeof j.body === 'object') return j.body;\n    if (typeof j.body === 'string') {\n      try { return JSON.parse(j.body); } catch(e) {}\n    }\n  }\n  return {};\n}\n\nfor (const item of items) {\n  const raw = parseRaw(item);\n\n  // Ticker/Name aus Watchlist als Fallback\n  let wlTicker = '', wlName = '';\n  try {\n    const wl = $('Watchlist laden (Fundamental)').item.json;\n    wlTicker = wl.ticker || '';\n    wlName   = wl.name   || '';\n  } catch(e) {}\n\n  const finalTicker = String(raw.ticker || wlTicker || 'unbekannt').trim();\n  const rawName     = fmtStr(raw.name);\n  const finalName   = (rawName !== 'k.A.') ? rawName : (wlName || finalTicker);\n\n  const hatEchteDaten = (\n    raw.ticker &&\n    raw.status === 'ok' &&\n    (raw.kgv != null || raw.kgvForward != null || raw.marktkapitalisierung != null)\n  );\n\n  if (!hatEchteDaten) {\n    const fehlerMsg = (raw.fehler && raw.fehler !== '')\n      ? String(raw.fehler)\n      : 'Keine Fundamentaldaten im Input des Aufbereitungs-Nodes gefunden.';\n    ergebnisse.push({ json: {\n      ticker: finalTicker, name: finalName,\n      kgv:'', kgvForward:'', kbv:'', dividendeRendite:'', dividendeJe:'',\n      exDividendeDatum:'', dividendenDatum:'', naechsterBericht:'', beta:'',\n      marktkapitalisierung:'', verschuldungsgrad:'', eigenkapitalrendite:'',\n      gewinnmarge:'', kursziel:'', empfehlung:'', regularMarketPrice:'',\n      waehrung:'', exchange:'', sector:'', industry:'',\n      zeitstempel, datum: heute, quelle: 'FastAPI/yfinance',\n      status: 'fehler', fehler: fehlerMsg,\n      letzter_fehler_zeitpunkt: zeitstempel,\n      _nur_status_update: true\n    }});\n    continue;\n  }\n\n  const waehrung = raw.currency || raw.waehrung || 'EUR';\n\n  // Dividendenrendite: FastAPI liefert bereits als Prozent (z.B. 1.65)\n  let divRendite = 'k.A.';\n  if (raw.dividendeRendite != null && raw.dividendeRendite !== '') {\n    divRendite = Number(raw.dividendeRendite).toFixed(2) + '%';\n  }\n\n  // eigenkapitalrendite kommt als Dezimalzahl (0.163 = 16.3%)\n  let eigenKap = 'k.A.';\n  if (raw.eigenkapitalrendite != null && raw.eigenkapitalrendite !== '') {\n    const v = Number(raw.eigenkapitalrendite);\n    eigenKap = (!isNaN(v) ? (v * 100).toFixed(1) : 'k.A.') + '%';\n  }\n\n  // gewinnmarge kommt als Dezimalzahl (0.195 = 19.5%)\n  let gewinnM = 'k.A.';\n  if (raw.gewinnmarge != null && raw.gewinnmarge !== '') {\n    const v = Number(raw.gewinnmarge);\n    gewinnM = (!isNaN(v) ? (v * 100).toFixed(1) : 'k.A.') + '%';\n  }\n\n  // verschuldungsgrad direkt als Zahl (z.B. 17.3)\n  let verschuld = 'k.A.';\n  if (raw.verschuldungsgrad != null && raw.verschuldungsgrad !== '') {\n    const v = Number(raw.verschuldungsgrad);\n    verschuld = (!isNaN(v) ? v.toFixed(1) : 'k.A.') + '%';\n  }\n\n  const out = {\n    ticker:               finalTicker,\n    name:                 finalName,\n    kgv:                  fmt(raw.kgv, 1),\n    kgvForward:           fmt(raw.kgvForward, 1),\n    kbv:                  fmt(raw.kbv, 2),\n    dividendeRendite:     divRendite,\n    dividendeJe:          (raw.dividendeJe != null && raw.dividendeJe !== '')\n                            ? fmt(raw.dividendeJe, 2) + ' ' + waehrung : 'k.A.',\n    exDividendeDatum:     fmtStr(raw.exDividendeDatum),\n    dividendenDatum:      fmtStr(raw.dividendenDatum),\n    naechsterBericht:     fmtStr(raw.naechsterBericht || ''),\n    beta:                 fmt(raw.beta, 2),\n    marktkapitalisierung: fmtMrd(raw.marktkapitalisierung),\n    verschuldungsgrad:    verschuld,\n    eigenkapitalrendite:  eigenKap,\n    gewinnmarge:          gewinnM,\n    kursziel:             fmt(raw.kursziel, 2),\n    empfehlung:           fmtStr(raw.empfehlung),\n    regularMarketPrice:   fmt(raw.regularMarketPrice, 2),\n    waehrung,\n    exchange:             fmtStr(raw.exchange),\n    sector:               fmtStr(raw.sector),\n    industry:             fmtStr(raw.industry),\n    zeitstempel,\n    datum:                heute,\n    quelle:               fmtStr(raw.quelle || 'FastAPI/yfinance'),\n    status:               'ok',\n    fehler:               '',\n    letzter_fehler_zeitpunkt: '',\n    _nur_status_update:   false,\n    // FIX 2026-07-31 (Phase 5 Schritt 1, Paket 13): Rohwerte zusaetzlich zu den\n    // obigen formatierten Anzeige-Strings speichern - FastAPI liefert sie bereits\n    // sauber numerisch, die Rundung/Formatierung oben passiert nur fuer die Anzeige.\n    // dividendeRendite/verschuldungsgrad kommen laut FastAPI bereits in Prozentpunkten,\n    // eigenkapitalrendite/gewinnmarge als Dezimalbruch (0.163 = 16.3%) - Rohwert jeweils\n    // unveraendert uebernommen, keine Umrechnung.\n    kgv_numeric:                  num(raw.kgv),\n    kgv_forward_numeric:          num(raw.kgvForward),\n    kbv_numeric:                  num(raw.kbv),\n    dividende_rendite_numeric:    num(raw.dividendeRendite),\n    dividende_je_numeric:         num(raw.dividendeJe),\n    beta_numeric:                 num(raw.beta),\n    marktkapitalisierung_numeric: num(raw.marktkapitalisierung),\n    verschuldungsgrad_numeric:    num(raw.verschuldungsgrad),\n    eigenkapitalrendite_numeric:  num(raw.eigenkapitalrendite),\n    gewinnmarge_numeric:          num(raw.gewinnmarge),\n    kursziel_numeric:             num(raw.kursziel),\n    regular_market_price_numeric: num(raw.regularMarketPrice)\n  };\n\n  sd.fundamentaldaten[finalTicker] = out;\n  ergebnisse.push({ json: out });\n}\n\nreturn ergebnisse;\n"
      },
