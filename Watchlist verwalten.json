    {
      "parameters": {
        "jsCode": "function pgStr(v) { return v === null || v === undefined ? 'NULL' : `'` + String(v).replace(/'/g, `''`) + `'`; }\nfunction pgArr(v) {\n  const arr = String(v || '').split(',').map(s => s.trim()).filter(Boolean);\n  return `'{` + arr.map(x => `\"` + x.replace(/\"/g, '\\\\\"') + `\"`).join(',') + `}'`;\n}\n\nconst j = $json.body || $json;\nconst action = String(j.action || '').trim();\nconst ticker = String(j.ticker || '').trim().toUpperCase();\n\nlet sql;\n\nif (action === 'add') {\n  const name = String(j.name || '').trim();\n  const sektor = String(j.sektor || '').trim();\n  if (!ticker || !name) {\n    sql = 'SELECT 1;';\n  } else {\n    sql = `INSERT INTO trading.watchlist (ticker, name, sektor, keywords, exclude_keywords, active)\n      VALUES (${pgStr(ticker)}, ${pgStr(name)}, ${pgStr(sektor)}, ${pgArr(j.keywords)}, ${pgArr(j.exclude_keywords)}, TRUE)\n      ON CONFLICT (ticker) DO UPDATE SET\n        name = EXCLUDED.name, sektor = EXCLUDED.sektor, keywords = EXCLUDED.keywords,\n        exclude_keywords = EXCLUDED.exclude_keywords, active = TRUE, updated_at = now();`;\n  }\n} else if (action === 'edit') {\n  const name = String(j.name || '').trim();\n  const sektor = String(j.sektor || '').trim();\n  sql = `UPDATE trading.watchlist SET\n    name = ${pgStr(name)}, sektor = ${pgStr(sektor)}, keywords = ${pgArr(j.keywords)},\n    exclude_keywords = ${pgArr(j.exclude_keywords)}, updated_at = now()\n    WHERE ticker = ${pgStr(ticker)};`;\n} else if (action === 'toggle_active') {\n  sql = `UPDATE trading.watchlist SET active = NOT active, updated_at = now() WHERE ticker = ${pgStr(ticker)};`;\n} else {\n  sql = 'SELECT 1;';\n}\n\nreturn [{ json: { sql } }];\n"
      },
