      "parameters": {
        "jsCode": "const b=$json.body||$json; const id=Number(b.id), action=String(b.action||''); if(action==='deactivate_all')return [{json:{sql:\"WITH upd AS (UPDATE trading.news_match_exclusions SET aktiv=FALSE,updated_at=now() WHERE aktiv=TRUE RETURNING 1) SELECT true AS ok,count(*)::text || ' Filter deaktiviert' AS message FROM upd\"}}]; if(action==='delete_all')return [{json:{sql:\"BEGIN; DELETE FROM trading.news_match_exclusion_hits; DELETE FROM trading.news_match_exclusions; UPDATE trading.news_match_exclusion_candidates SET status='pending',reviewed_at=NULL,reviewed_by=NULL WHERE status='approved'; COMMIT; SELECT true AS ok,'Alle Filter und Treffer gel�scht; freigegebene Kandidaten wieder pending'::text AS message\"}}]; if(!Number.isInteger(id)||id<1||!['activate','deactivate'].includes(action))return [{json:{sql:\"SELECT false AS ok,'Ung�ltige Anfrage'::text AS message\"}}]; return [{json:{sql:`UPDATE trading.news_match_exclusions SET aktiv=${action==='activate'?'TRUE':'FALSE'},updated_at=now() WHERE id=${id} RETURNING true AS ok,CASE WHEN aktiv THEN 'aktiviert' ELSE 'deaktiviert' END AS message`}}];"
