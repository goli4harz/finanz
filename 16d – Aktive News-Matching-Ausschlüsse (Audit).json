        "jsCode": "function esc(v){return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');} const rows=$input.all().map(i=>i.json).filter(r=>r?.id!==undefined); const body=rows.length?rows.map(r=>`<tr><td>${esc(r.id)}</td><td>${esc(r.ticker)}</td><td>${esc(r.pattern)}</td><td>${r.aktiv?'aktiv':'inaktiv'}</td><td>${esc(r.hit_count)}</td><td>${esc(r.last_hit_at)}</td><td><form method=\"post\" action=\"/webhook/historische-news-ausschluesse\"><input type=\"hidden\" name=\"id\" value=\"${esc(r.id)}\"><button name=\"action\" value=\"${r.aktiv?'deactivate':'activate'}\">${r.aktiv?'Deaktivieren':'Aktivieren'}</button></form></td></tr>`).join(''):'<tr><td colspan=\"7\"><strong>Keine Blacklist-Regel vorhanden.</strong> Zuerst einen pending-Kandidaten auf der <a href=\"/webhook/historische-news-lernkandidaten\">Freigabeseite 16c</a> freigeben.</td></tr>'; return [{json:{html:`<!doctype html><html lang=\"de\"><head><meta charset=\"utf-8\"><title>Aktive News-Ausschlüsse</title><style>body{font-family:sans-serif;background:#181818;color:#eee;padding:24px}a{color:#8ab4ff}table{border-collapse:collapse;width:100%}th,td{border:1px solid #444;padding:8px}button{padding:7px;margin:3px}.reset{background:#a63;color:#fff;border:0}.delete{background:#a00;color:#fff;border:0}</style></head><body><div style=\"background:#232323;border:1px solid #444;border-radius:6px;padding:8px 14px;margin-bottom:20px;display:flex;flex-wrap:wrap;gap:4px 16px;font-size:13px;\"><a href=\"/webhook/aktien-status\" style=\"color:#8ab4f8;text-decoration:none;\">Status</a><a href=\"/webhook/aktien-watchlist\" style=\"color:#8ab4f8;text-decoration:none;\">Watchlist</a><a href=\"/webhook/rss-quellen\" style=\"color:#8ab4f8;text-decoration:none;\">RSS-Quellen</a><a href=\"/webhook/lernvorschlaege\" style=\"color:#8ab4f8;text-decoration:none;\">Lernvorschlaege</a><a href=\"/webhook/historische-marktdaten\" style=\"color:#8ab4f8;text-decoration:none;\">Marktdaten-Import</a><a href=\"/webhook/historische-nachrichten\" style=\"color:#8ab4f8;text-decoration:none;\">Nachrichten-Import</a><a href=\"/webhook/historische-news-lernkandidaten\" style=\"color:#8ab4f8;text-decoration:none;\">News-Lernkandidaten</a><a href=\"/webhook/historische-news-ausschluesse\" style=\"color:#8ab4f8;text-decoration:none;\">Ausschlussregeln</a><a href=\"/webhook/historische-simulation\" style=\"color:#8ab4f8;text-decoration:none;\">Simulationslaeufe</a><a href=\"/webhook/simulation-lauf\" style=\"color:#8ab4f8;text-decoration:none;\">Simulation starten</a><a href=\"/webhook/simulation-uebersicht\" style=\"color:#8ab4f8;text-decoration:none;\">Sim-Uebersicht</a><a href=\"/webhook/simulation-vergleich\" style=\"color:#8ab4f8;text-decoration:none;\">Sim-Vergleich</a></div><h1>Aktive News-Matching-Ausschlüsse</h1><p>Nur manuell freigegebene Regeln. Rohmeldungen bleiben erhalten.</p><form method=\"post\" action=\"/webhook/historische-news-ausschluesse\" onsubmit=\"return confirm('Wirklich alle Filter deaktivieren? Die Trefferhistorie bleibt erhalten.')\"><button class=\"reset\" name=\"action\" value=\"deactivate_all\">Alle Filter deaktivieren</button></form><form method=\"post\" action=\"/webhook/historische-news-ausschluesse\" onsubmit=\"return confirm('TESTRESET: Wirklich ALLE Filter und Trefferprotokolle löschen? Freigegebene Kandidaten werden wieder pending. Rohmeldungen und Assessments bleiben erhalten.')\"><button class=\"delete\" name=\"action\" value=\"delete_all\">Alle Filter vollständig löschen (Testreset)</button></form><table><tr><th>ID</th><th>Ticker</th><th>Phrase</th><th>Status</th><th>Treffer</th><th>Letzter Treffer</th><th>Aktion</th></tr>${body}</table></body></html>`}}];"
