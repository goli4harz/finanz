      "parameters": {
        "jsCode": "// Datenqualitaetspruefung: mindestens 1 aktuelles technisches Signal UND\n// mindestens 1 heutige (roh oder bewertete) News-Aktivitaet muessen vorliegen,\n// sonst gilt der Geschaeftstag als unvollstaendig (Abbruchregel).\nconst signale = $('DB: Heutige Signale zaehlen').all();\nconst news = $('DB: Heutige News zaehlen').all();\n\nconst signaleOk = signale.length > 0;\n// Newsausfall ist eine WARNUNG, kein harter Abbruch (News koennen an ruhigen Tagen\n// tatsaechlich leer sein) - der Auftrag verlangt Abbruch nur bei \"vollstaendig\n// ausgefallen\", was hier als 0 Zeilen interpretiert wird, siehe Abbruchregeln-IF unten.\nconst newsOk = news.length > 0;\n\nreturn { json: {\n  run_id: $('Run-ID erzeugen').item.json.run_id,\n  business_date: $('Run-ID erzeugen').item.json.business_date,\n  signale_count: signale.length,\n  news_count: news.length,\n  signale_ok: signaleOk,\n  news_ok: newsOk,\n  datenqualitaet_ok: signaleOk\n} };\n"
      },
